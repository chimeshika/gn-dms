# Replace paths, server_name, and PHP-FPM socket for your deployment.
# Add TLS configuration and redirect HTTP to HTTPS for production.
server {
    listen 80;
    server_name gn-dms.example.com;
    root /srv/gn-dms/frontend/dist;
    index index.html;
    client_max_body_size 12m;

    location ^~ /api/ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /srv/gn-dms/backend/public/index.php;
        fastcgi_param DOCUMENT_ROOT /srv/gn-dms/backend/public;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ /\. {
        deny all;
    }
}
